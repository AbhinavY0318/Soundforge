# ==============================================================================
# SoundForge Platform - Master Environment Configuration Template
# For local development: copy this file to .env in project root.
# For production: configure these environment variables in Render and Vercel.
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
FRONTEND_PORT=5173
APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 1. MongoDB Database
# ------------------------------------------------------------------------------
# Local (Docker replica set):
MONGODB_URI=mongodb://localhost:27017/soundforge?replicaSet=rs0&directConnection=true
# Production (MongoDB Atlas M0 Free Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/soundforge?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Redis Cache & BullMQ Queue
# ------------------------------------------------------------------------------
# Local (Docker standalone Redis):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Production (Upstash Redis Single Connection URL):
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. JWT Authentication Secrets (Dashboard Auth)
# ------------------------------------------------------------------------------
# Generate 32+ character random strings for production:
JWT_ACCESS_SECRET=soundforge_super_secure_access_secret_change_in_production_32chars
JWT_REFRESH_SECRET=soundforge_super_secure_refresh_secret_change_in_production_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# 4. Audio Storage (S3 / MinIO / Managed Object Storage)
# ------------------------------------------------------------------------------
# Local (Docker MinIO):
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=soundforge-audio
MINIO_PUBLIC_URL=http://localhost:9000
# Production (Cloudflare R2 / Supabase Storage / Managed S3):
# MINIO_ENDPOINT=<account_id>.r2.cloudflarestorage.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_ACCESS_KEY=<r2_access_key_id>
# MINIO_SECRET_KEY=<r2_secret_access_key>
# MINIO_BUCKET_NAME=soundforge-audio
# MINIO_PUBLIC_URL=https://pub-<hash>.r2.dev

# ------------------------------------------------------------------------------
# 5. AI Music Generation Provider
# ------------------------------------------------------------------------------
# Provider mode: "mock" (free synthetic PCM WAV) or "elevenlabs" (production API)
MUSIC_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=music_v1
MINIMAX_API_KEY=

# Mock Provider Settings (Latency simulation & testing)
MOCK_PROVIDER_LATENCY_MS=1500
MOCK_PROVIDER_FAILURE_RATE=0.0
MOCK_PROVIDER_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 6. Transactional Email Service
# ------------------------------------------------------------------------------
# Provider mode: "mock" (auto-verified token return), "resend", or "smtp"
EMAIL_SERVICE_PROVIDER=mock
RESEND_API_KEY=
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SoundForge Support <no-reply@soundforge.ai>"

# ------------------------------------------------------------------------------
# 7. Webhook Dispatcher
# ------------------------------------------------------------------------------
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
