# ==============================================================================
# SoundForge Platform - Environment Configuration Example
# Copy this file to .env before starting the application.
# ==============================================================================

NODE_ENV=development
PORT=4000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000

# MongoDB Configuration (Replica set URI for multi-document transaction support)
MONGODB_URI=mongodb://localhost:27017/soundforge?replicaSet=rs0&directConnection=true

# Redis Configuration (Distributed locks, rate limiting, and BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets for Dashboard Authentication
JWT_ACCESS_SECRET=soundforge_super_secure_access_secret_change_in_production_32chars
JWT_REFRESH_SECRET=soundforge_super_secure_refresh_secret_change_in_production_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO / S3 Audio Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=soundforge-audio
MINIO_PUBLIC_URL=http://localhost:9000

# AI Music Provider Configuration
# Supported providers: mock, elevenlabs, minimax
MUSIC_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=music_v1
MINIMAX_API_KEY=

# Mock Provider Configuration (Used for testing and sandbox demo)
MOCK_PROVIDER_LATENCY_MS=1500
MOCK_PROVIDER_FAILURE_RATE=0.0
MOCK_PROVIDER_TIMEOUT_MS=30000

# Email Service (Verification & password resets - mock or smtp)
EMAIL_SERVICE_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SoundForge Support <no-reply@soundforge.ai>"
APP_BASE_URL=http://localhost:5173

# Webhook Delivery
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
